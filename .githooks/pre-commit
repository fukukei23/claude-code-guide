#!/bin/bash
# pre-commit hook: source/*.md が変更されていたら convert.py を自動実行

REPO_ROOT="$(git rev-parse --show-toplevel)"

# source/*.md の変更を検出（日本語ファイル名対応: -z で NUL区切り出力）
if git diff --cached --name-only -z | tr '\0' '\n' | grep -q '^source/.*\.md$'; then
    # 日本語品質警告（層1suiko・昇格済み2検出器のみ・warn-only・fail-open・2026-09-25）
    if [ -x "$HOME/bin/suiko" ]; then
        for f in $(git diff --cached --name-only | grep '^source/.*\.md$' || true); do
            out=$(timeout 3 "$HOME/bin/suiko" lint --genre tech --json "$f" 2>/dev/null) || continue
            warns=$(printf '%s' "$out" | timeout 3 python3 -c 'import json,sys
try:
    d=json.load(sys.stdin); fs=d.get("findings",[]) if isinstance(d,dict) else d
    for x in fs:
        if isinstance(x,dict) and x.get("category") in ("redundant_light_verb","hype_expression"):
            print("  [参考] "+x.get("category","")+": "+str(x.get("excerpt",""))[:60])
except Exception: pass' 2>/dev/null) || continue
            if [ -n "$warns" ]; then
                echo "⚠️ [層1 suiko・参考] $f:"
                printf '%s\n' "$warns"
                echo ""
            fi
        done
    fi
    echo '📝 source/*.md の変更を検出 → convert.py を実行中...'
    cd "$REPO_ROOT"
    python3 convert.py
    if [ $? -ne 0 ]; then
        echo '❌ convert.py が失敗しました。コミットを中止します。'
        exit 1
    fi
    # 生成されたHTMLをステージングに追加
    git add -f docs/index.html docs/chapters/*.html
    echo '✅ HTML生成完了・ステージング済み'
fi

exit 0
